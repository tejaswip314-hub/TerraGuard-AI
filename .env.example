# TerraGuard AI Environment Configuration

# This file contains example environment variables for TerraGuard AI project.
# Copy this file to .env and update values as needed for your development environment.

# Server Configuration
PORT=8000
HOST=localhost
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/terraguard
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_KEY=your_api_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Machine Learning Configuration
DEFAULT_MODEL=logistic_regression_baseline
MODEL_STORAGE_PATH=./models
MAX_MODEL_MEMORY=4GB

# Geospatial Data Configuration
# ⚠️ SECURITY: Never store API keys in frontend code or source control.
# The following keys should be configured on the backend and accessed
# via secure API endpoints. Frontend should use relative proxy URLs.
GSI_API_KEY=your_gsi_api_key_here  # Backend-only; not for frontend use
NRSC_API_TOKEN=your_nrsc_token_here  # Backend-only; not for frontend use
USAC_ACCESS_CODE=your_usac_access_code  # Backend-only; not for frontend use

# ⚠️ FRONTEND CREDENTIALS: If any API keys are required in the frontend,
# they must be loaded via backend proxy endpoints, not directly.
# See: .env.example comments and UI_UX_SPEC.md "Security: Credential Configuration Approach"

# Data Paths
DATA_DIR=./data
OUTPUT_DIR=./outputs
TEMP_DIR=./temp

# ML Features Configuration
FEATURE_SET=terrain,climate,geology,human_impact
FEATURE_THRESHOLD=0.1

# Model Training Configuration
BATCH_SIZE=32
EPOCHS=100
LEARNING_RATE=0.001

# Security Configuration
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# Monitoring and Logging
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true
GRAFANA_URL=http://localhost:3000

# External Services
EMAIL_SERVICE=sendgrid
EMAIL_FROM=noreply@terraguard.ai

# Project Configuration
PROJECT_NAME=TerraGuard AI
PROJECT_VERSION=1.0.0
PROJECT_DESCRIPTION=Full-stack machine learning application for landslide susceptibility mapping in Uttarakhand, India

# Data Processing
PARALLEL_JOBS=4
CHUNK_SIZE=10000

# Cache Configuration
CACHE_TTL=3600
MAX_CACHE_SIZE=1000

# External API Limits
GSI_RATE_LIMIT=1000
NRSC_RATE_LIMIT=5000
USAC_RATE_LIMIT=100

# ML Model Validation
SPATIAL_VALIDATION=true
CROSS_VALIDATION_FOLDS=5

# File Upload Configuration
MAX_UPLOAD_SIZE=100MB
ALLOWED_EXTENSIONS=.csv,.json,.geojson,.tif,.tiff,.shp

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60